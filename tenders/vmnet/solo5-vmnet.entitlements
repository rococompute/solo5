<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Lets an unprivileged process start a vmnet(3) interface on macOS 26.
	  Unlike com.apple.vm.networking, it is not restricted, so an ad-hoc
	  signature is enough.
	-->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
